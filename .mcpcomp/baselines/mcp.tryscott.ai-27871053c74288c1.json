    },
    {
      "id": "token-trust.rejected-credential-error-code",
      "family": "token_trust",
      "normative": "SHOULD",
      "severity": "low",
      "title": "The 401 for a rejected credential names no error code",
      "message": "The server refused an invalid bearer token with 401 and the challenge \"Bearer resource_metadata=\\\"https://mcp.tryscott.ai/.well-known/oauth-protected-resource\\\"\", which carries no error attribute. OAuth 2.1 §5.3.1 says a resource server SHOULD include error (invalid_token, per §5.3.2) when the request presented a token that failed — the client then knows the credential was declined rather than merely missing. No reference client currently reads this on a 401, so nothing breaks today; it is the recommendation, reported as such.",
      "evidence": [
        "https://mcp.tryscott.ai/mcp — initialize with an invalid bearer token: HTTP 401",
        "same request without a credential: HTTP 401"
      ],
      "specReferences": [
        {
          "id": "OAuth-2.1-resource-error-response",
          "url": "https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-13#section-5.3.1"
        },
        {
          "id": "MCP-Token-handling",
          "url": "https://modelcontextprotocol.io/specification/2025-11-25/basic/authorization#token-handling"
        }
      ],
      "probeTier": "passive",
      "fix": "Add error=\"invalid_token\" to the WWW-Authenticate challenge on a 401 that rejects a presented token; leave it off the 401 for a request that carried none."
    }
  ],
