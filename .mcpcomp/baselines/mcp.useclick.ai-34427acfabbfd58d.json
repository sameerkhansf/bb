  "findings": [
    {
      "id": "client-compatibility.issuer-response",
      "family": "client_compatibility",
      "normative": "SHOULD",
      "severity": "medium",
      "title": "Authorization-response issuer binding is not advertised",
      "message": "The authorization server does not advertise authorization_response_iss_parameter_supported, reducing protection against authorization-server mix-up during callback. This advisory is a dated forecast, in the specification's own words: \"A future revision of this specification is expected to upgrade authorization server inclusion of iss from SHOULD to MUST.\" When that revision ships, this finding becomes a requirement violation.",
      "evidence": [
        "https://exquisite-constellation-40.authkit.app/.well-known/oauth-authorization-server"
      ],
      "specReferences": [
        {
          "id": "RFC-9207-iss-parameter",
          "url": "https://www.rfc-editor.org/rfc/rfc9207.html#section-2"
        }
      ],
      "probeTier": "passive",
      "fix": "Enable RFC 9207 and advertise authorization_response_iss_parameter_supported: true."
    }
  ],
